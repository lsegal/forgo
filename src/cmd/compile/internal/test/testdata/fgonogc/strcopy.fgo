// Rebuilding a path of nodes with string fields frees every buffer.
package main

import (
	"fmt"
	"strconv"

	"fgo/nogc"
)

type node struct {
	key         int
	name        string
	left, right *node
}

func insert(t *node, k int) *node {
	if t == nil {
		return &node{key: k, name: strconv.Itoa(k)}
	}
	if k < t.key {
		return &node{key: t.key, name: t.name, left: insert(t.left, k), right: t.right}
	}
	return &node{key: t.key, name: t.name, left: t.left, right: insert(t.right, k)}
}

//fgo:nogc
func build(n int) int {
	var root *node
	for j := range n {
		root = insert(root, j*7919%1000)
	}
	live := nogc.Live()
	if root.key < 0 { // root's last use, after counting it live
		return 0
	}
	return live
}

//fgo:nogc
func seq(keys []int) {
	var root *node
	for _, k := range keys {
		root = insert(root, k)
	}
}

func main() {
	base := nogc.Live()
	for _, ks := range [][]int{{1}, {1, 2}, {2, 1}, {1, 2, 3}, {3, 2, 1}, {2, 1, 3}, {1, 1}} {
		seq(ks)
		if n := nogc.Live() - base; n != 0 {
			panic(fmt.Sprint(ks, " leaked ", n))
		}
	}
	if build(1000)-base != 2000 || nogc.Live() != base {
		panic("build leaked")
	}
}
