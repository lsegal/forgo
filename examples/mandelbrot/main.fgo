//go:build amd64 || arm64

package main

import (
	"encoding/binary"
	"errors"
	"fmt"
	"os"
	"strconv"
	"testing"
)

const (
	defaultWidth      = 1024
	defaultHeight     = aspectHeight(1024)
	defaultIterations = 256
)

//fgo:comptime
func aspectHeight(width int) int {
	return width * 3 / 4
}

type config struct {
	width      int
	height     int
	iterations int
}

type point struct {
	re float32
	im float32
}

type escape struct {
	iterations int32
	escaped    uint32
}

var escapeSink []escape

func parseConfig(args []string) (cfg *config, err error) {
	cfg = &config{defaultWidth, defaultHeight, defaultIterations}
	throw "usage: mandelbrot [width [height [iterations]]]" if len(args) > 3
	cfg.width = strconv.Atoi(args[0])? if len(args) > 0
	cfg.height = strconv.Atoi(args[1])? if len(args) > 1
	cfg.iterations = strconv.Atoi(args[2])? if len(args) > 2
	throw "width and height must be positive" if cfg.width <= 0 || cfg.height <= 0
	throw fmt.Errorf("width must be a multiple of %d", laneCount) if cfg.width%laneCount != 0
	throw "iterations must be between 1 and 32767" if cfg.iterations < 1 || cfg.iterations > 32767
	return
}

func makePoints(cfg *config) []point {
	dx := float32(3) / float32(cfg.width)
	dy := float32(2.4) / float32(cfg.height)
	points := make([]point, cfg.width*cfg.height)
	for y := range cfg.height {
		yOffset := float32(float32(y) * dy)
		ci := float32(float32(-1.2) + yOffset)
		for x := range cfg.width {
			xOffset := float32(float32(x) * dx)
			cr := float32(float32(-2) + xOffset)
			points[y*cfg.width+x] = point{cr, ci}
		}
	}
	return points
}

func mandelbrotScalar(escapes []escape, points []point, maxIterations int32) {
	for i, p := range points {
		cx, cy := p.re, p.im
		cardioidX := float32(cx - 0.25)
		ySquared := float32(cy * cy)
		cardioidSquare := float32(cardioidX * cardioidX)
		q := float32(cardioidSquare + ySquared)
		qShifted := float32(q + cardioidX)
		cardioidMetric := float32(q * qShifted)
		cardioidLimit := float32(float32(0.25) * ySquared)
		inside := cardioidMetric <= cardioidLimit
		shifted := float32(cx + 1)
		bulbSquare := float32(shifted * shifted)
		inside = inside || float32(bulbSquare+ySquared) <= 0.0625

		var zx, zy, zxSquared, zySquared float32
		var iteration int32
		if inside {
			iteration = maxIterations
		}
		var escaped uint32
		for iteration < maxIterations {
			if float32(zxSquared+zySquared) > 4 {
				escaped = 1
				break
			}
			doubledZx := float32(zx * 2)
			product := float32(doubledZx * zy)
			zy = float32(product + cy)
			difference := float32(zxSquared - zySquared)
			zx = float32(difference + cx)
			zxSquared = float32(zx * zx)
			zySquared = float32(zy * zy)
			iteration++
		}
		escapes[i] = escape{iteration, escaped}
	}
}

func checksum(escapes []escape) uint64 {
	var sum uint64
	for _, result := range escapes {
		sum += uint64(result.iterations)
	}
	return sum
}

func writeResults(path string, escapes []escape) (err error) {
	data := make([]byte, len(escapes)*8)
	for i, result := range escapes {
		binary.LittleEndian.PutUint32(data[i*8:], uint32(result.iterations))
		binary.LittleEndian.PutUint32(data[i*8+4:], result.escaped)
	}
	os.WriteFile(path, data, 0o644)?
	return
}

func measure(kernel func()) testing.BenchmarkResult {
	return testing.Benchmark(func(b *testing.B) {
		b.ReportAllocs()
		for range b.N {
			kernel()
		}
	})
}

func printResult(name string, pixels int, result testing.BenchmarkResult) {
	ns := result.NsPerOp()
	megapixelsPerSecond := float64(pixels) * 1e3 / float64(ns)
	fmt.Printf("%-8s %10d ns/frame  %8.2f MPix/s  %d allocs/op\n",
		name, ns, megapixelsPerSecond, result.AllocsPerOp())
}

func run() (err error) {
	cfg := parseConfig(os.Args[1:])?
	throw "required SIMD instructions are unavailable" if !simdSupported()

	points := makePoints(cfg)
	scalarEscapes := make([]escape, len(points))
	simdEscapes := make([]escape, len(points))
	mandelbrotScalar(scalarEscapes, points, int32(cfg.iterations))
	mandelbrotSIMD(simdEscapes, points, int32(cfg.iterations))
	for i, scalar := range scalarEscapes {
		simd := simdEscapes[i]
		throw fmt.Errorf("pixel %d mismatch: scalar=%d/%d simd=%d/%d",
			i, scalar.iterations, scalar.escaped, simd.iterations, simd.escaped) if scalar != simd
	}

	if path := os.Getenv("MANDELBROT_RESULTS"); path != "" {
		writeResults(path, simdEscapes)?
	}

	pixels := len(points)
	fmt.Printf("Mandelbrot: %dx%d, %d max iterations, checksum %d\n",
		cfg.width, cfg.height, cfg.iterations, checksum(simdEscapes))
	scalar := measure(func() {
		mandelbrotScalar(scalarEscapes, points, int32(cfg.iterations))
		escapeSink = scalarEscapes
	})
	simd := measure(func() {
		mandelbrotSIMD(simdEscapes, points, int32(cfg.iterations))
		escapeSink = simdEscapes
	})
	printResult("scalar", pixels, scalar)
	printResult(simdName, pixels, simd)
	fmt.Printf("speedup  %.2fx\n", float64(scalar.NsPerOp())/float64(simd.NsPerOp()))
	return
}

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, "mandelbrot:", err)
		os.Exit(2)
	}
}
