//go:build amd64

package main

import "simd/archsimd"

const (
	laneCount = 8
	simdName  = "AVX2 x8"
)

func simdSupported() bool {
	return archsimd.X86.AVX2()
}

func mandelbrotSIMD(escapes []escape, points []point, maximum int32) {
	four := archsimd.BroadcastFloat32x8(4)
	two := archsimd.BroadcastFloat32x8(2)
	one := archsimd.BroadcastInt32x8(1)
	oneFloat := archsimd.BroadcastFloat32x8(1)
	quarter := archsimd.BroadcastFloat32x8(0.25)
	sixteenth := archsimd.BroadcastFloat32x8(0.0625)
	maxIterations := archsimd.BroadcastInt32x8(maximum)

	var cxValues, cyValues [laneCount]float32
	var iterationValues [laneCount]int32
	var escapedValues [laneCount]int32
	for i := 0; i < len(points); i += laneCount {
		for lane := range laneCount {
			cxValues[lane] = points[i+lane].re
			cyValues[lane] = points[i+lane].im
		}
		cx := archsimd.LoadFloat32x8(cxValues[:])
		cy := archsimd.LoadFloat32x8(cyValues[:])
		cardioidX := cx.Sub(quarter)
		ySquared := cy.Mul(cy)
		q := cardioidX.Mul(cardioidX).Add(ySquared)
		cardioidMetric := q.Mul(q.Add(cardioidX))
		cardioidLimit := quarter.Mul(ySquared)
		inCardioid := cardioidMetric.LessEqual(cardioidLimit)
		shifted := cx.Add(oneFloat)
		bulbMetric := shifted.Mul(shifted).Add(ySquared)
		inBulb := bulbMetric.LessEqual(sixteenth)
		inside := inCardioid.Or(inBulb)

		var zx, zy, zxSquared, zySquared archsimd.Float32x8
		iteration := maxIterations.Masked(inside)
		active := cardioidMetric.Greater(cardioidLimit).And(bulbMetric.Greater(sixteenth))
		for round := int32(0); round < maximum; round++ {
			active = active.And(zxSquared.Add(zySquared).LessEqual(four))
			break if active.ToBits() == 0
			zy = zx.Mul(two).Mul(zy).Add(cy)
			zx = zxSquared.Sub(zySquared).Add(cx)
			zxSquared = zx.Mul(zx)
			zySquared = zy.Mul(zy)
			iteration = iteration.Add(one.Masked(active))
		}
		iteration.Store(iterationValues[:])
		one.Masked(iteration.Less(maxIterations)).Store(escapedValues[:])
		for lane := range laneCount {
			escapes[i+lane] = escape{iterationValues[lane], uint32(escapedValues[lane])}
		}
	}
}
